# ===== WorkBuddy Bot 环境变量示例 =====
# 复制本文件为 .env 并按需填写。.env 已在 .gitignore 中，不会被提交。

# 运行环境：cloud（WorkBuddy 云端）或 local（本地电脑）
WORKBUDDY_ENV=local

# 数据目录（上下文共享与会话文件的存储位置，相对项目根目录）
WORKBUDDY_DATA_DIR=data

# ===== LLM 接入（可选，OpenAI 兼容接口）=====
# 不配置时进入「离线草稿模式」：不调用任何外部模型，输出结构化草稿。
# 云端环境建议通过平台环境变量注入，不要写入配置文件。
WORKBUDDY_LLM_BASE_URL=https://api.openai.com/v1
WORKBUDDY_LLM_API_KEY=
WORKBUDDY_LLM_MODEL=gpt-4o-mini
